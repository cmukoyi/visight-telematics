# tenants/pinplot/.env.template
#
# Required environment variables for the ViSight Telematics tenant.
# Lives in `gps-tracker/backend/.env` on the production server.
#
# This file is a TEMPLATE only — never put real secrets in git.
# Real values are set:
#   - Manually on the server in /home/deploy/visght-telematics/gps-tracker/backend/.env, or
#   - Via GitHub Actions secrets injected by the deploy workflow.
#
# Used by /api/branding (backend/app/main.py) and docker-compose.yml.

# ─── Branding (drives /api/branding) ───────────────────────────────────
BRAND_NAME=ViSight Telematics
BRAND_PRODUCT=ViSight Telematics Portal
BRAND_DOMAIN=track.visighttelematics.co.za
BRAND_SUPPORT_EMAIL=support@visighttelematics.co.za
BRAND_FROM_EMAIL=noreply@visighttelematics.co.za
BRAND_PRIMARY_COLOR=#3B82F6
BRAND_THEME_COLOR=#0F1117
BRAND_TAGLINE=Live asset tracking, geofencing, and reporting.

# ─── MapTiler (per-tenant key, origin-restricted) ──────────────────────
MAPTILER_KEY=__SET_ON_SERVER__

# ─── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=visight_db_user
POSTGRES_PASSWORD=REPLACE_WITH_ROTATED_DB_PASSWORD
POSTGRES_DB=visight_db
DATABASE_URL=postgresql://visight_db_user:REPLACE_WITH_ROTATED_DB_PASSWORD@db:5432/visight_db

# ─── Tenant identity (used by Phase 3.2 docker-compose templating) ─────
TENANT_PREFIX=visight_telematics
TENANT_SLUG=pinplot

# ─── Backend secrets ───────────────────────────────────────────────────
SECRET_KEY=__SET_ON_SERVER__
JWT_SECRET=__SET_ON_SERVER__

# ─── SendGrid (transactional email) ────────────────────────────────────
SENDGRID_API_KEY=__SET_ON_SERVER__
FROM_EMAIL=noreply@visighttelematics.co.za
CORS_ORIGINS=https://track.visighttelematics.co.za

# ─── App / API ─────────────────────────────────────────────────────────
APP_BASE_URL=https://track.visighttelematics.co.za
NODE_ENV=production

# ─── Feature Flags ────────────────────────────────────────────────────────
# Comma-separated list of features to hide from portal (bridge still runs).
# Phase 2 (dark launch): TENANT_DISABLED_FEATURES=floorplan
# Phase 3 (canary/live):  TENANT_DISABLED_FEATURES=  (empty = fully enabled)
TENANT_DISABLED_FEATURES=

# ─── Feature Flags (Phase 2 dark launch) ──────────────────────────────
# Comma-separated list of features to hide from portal (bridge still runs).
# Phase 2: TENANT_DISABLED_FEATURES=floorplan
# Phase 3: TENANT_DISABLED_FEATURES=  (empty = fully enabled)
TENANT_DISABLED_FEATURES=
