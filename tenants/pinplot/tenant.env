# tenants/pinplot/tenant.env
#
# Substitution variables for gps-tracker/docker-compose.template.yml.
# Read by scripts/build.sh to assemble gps-tracker/docker-compose.yml.
#
# CRITICAL: TENANT_PREFIX is the docker volume name prefix. Renaming it
# orphans postgres data. Do NOT change after first deploy.

TENANT_PREFIX=pinplot
TENANT_DB_USER=pinplot_db_user
TENANT_DB_NAME=pinplot_db
