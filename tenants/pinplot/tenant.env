# tenants/pinplot/tenant.env
#
# Substitution variables for gps-tracker/docker-compose.template.yml.
# Read by scripts/build.sh to assemble gps-tracker/docker-compose.yml.
#
# CRITICAL: TENANT_PREFIX is the docker volume name prefix. Renaming it
# orphans postgres data. Do NOT change after first deploy.

TENANT_PREFIX=visight_telematics
TENANT_DB_USER=visight_db_user
TENANT_DB_NAME=visight_db

# Used by .github/workflows/deploy-production.yml (Phase 4 unified workflow).
# SERVER_DIR  = absolute path on the deploy host where this tenant's tree lives
# DISPLAY_NAME = human-friendly name used in deployment summary output
SERVER_DIR=/home/deploy/visght-telematics
DISPLAY_NAME="ViSight Telematics"

# Optional compose profiles. "dataprofiler" runs the Teltonika event pipeline
# (GPRS listener on :5027, RabbitMQ, events DB, writer, decoder) and requires
# EVENTS_DB_PASSWORD and RABBITMQ_PASSWORD in the server's backend/.env.
COMPOSE_PROFILES=dataprofiler
