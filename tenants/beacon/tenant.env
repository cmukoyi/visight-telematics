# tenants/beacon/tenant.env
#
# Substitution variables for gps-tracker/docker-compose.template.yml.
# Read by scripts/build.sh to assemble gps-tracker/docker-compose.yml.
#
# CRITICAL: TENANT_PREFIX is the docker volume name prefix. Beacon's
# existing production volume is `beacon_telematics_postgres_data`.
# Renaming this prefix orphans production data. Do NOT change.

TENANT_PREFIX=beacon_telematics
TENANT_DB_USER=beacon_user
TENANT_DB_NAME=beacon_telematics
