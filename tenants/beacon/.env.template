# tenants/beacon/.env.template
#
# Required environment variables for the Beacon Telematics tenant.
# Lives in `gps-tracker/backend/.env` on the production server.
#
# This file is a TEMPLATE only — never put real secrets in git.
# Real values are set:
#   - Manually on the server in /root/beacon/gps-tracker/backend/.env, or
#   - Via GitHub Actions secrets injected by the deploy workflow.
#
# Used by /api/branding (backend/app/main.py) and docker-compose.yml.

# ─── Branding (drives /api/branding) ───────────────────────────────────
BRAND_NAME=Beacon Telematics
BRAND_PRODUCT=Beacon Telematics Customer Portal
BRAND_DOMAIN=beacontelematics.co.uk
BRAND_SUPPORT_EMAIL=support@beacontelematics.co.uk
BRAND_FROM_EMAIL=noreply@beacontelematics.co.uk
BRAND_PRIMARY_COLOR=#3B82F6
BRAND_THEME_COLOR=#0F1117
BRAND_TAGLINE=Live asset tracking, geofencing, and reporting.

# ─── MapTiler (per-tenant key, origin-restricted) ──────────────────────
MAPTILER_KEY=__SET_ON_SERVER__

# ─── Postgres ──────────────────────────────────────────────────────────
# These names are referenced by docker-compose.yml; do NOT change without
# also planning a data migration (renaming the database = data loss).
POSTGRES_USER=beacon_user
POSTGRES_PASSWORD=__SET_ON_SERVER__
POSTGRES_DB=beacon_telematics

# ─── Tenant identity (used by Phase 3.2 docker-compose templating) ─────
TENANT_PREFIX=beacon_telematics
TENANT_SLUG=beacon

# ─── Backend secrets ───────────────────────────────────────────────────
SECRET_KEY=__SET_ON_SERVER__
JWT_SECRET=__SET_ON_SERVER__

# ─── SendGrid (transactional email) ────────────────────────────────────
SENDGRID_API_KEY=__SET_ON_SERVER__
FROM_EMAIL=noreply@beacontelematics.co.uk

# ─── App / API ─────────────────────────────────────────────────────────
APP_BASE_URL=https://beacontelematics.co.uk
NODE_ENV=production

# ─── Feature Flags ─────────────────────────────────────────────────────
# Beacon gets floorplan ONLY after pinplot validates Phase 2→3 successfully.
# Keep floorplan disabled here until pinplot has 48h+ stability.
TENANT_DISABLED_FEATURES=floorplan
FLOORPLAN_BRIDGE_ENABLED=1
