# Pareto Anywhere / BLE Indoor Tracking (Optional)
# For Floorplan MVP feature only. If FLOORPLAN_BRIDGE_ENABLED=0,
# these settings are unused.

# URL of the Pareto Anywhere Socket.IO server.
# For Docker deployments, this should match the service name in
# docker-compose (http://pareto-anywhere:3001).
# For external Pareto, use the full URL (e.g., http://192.168.1.100:3001).
PARETO_URL=http://pareto-anywhere:3001

# Enable/disable the Pareto bridge background task at backend startup.
# Set to 0 to disable floorplan bridge even if Pareto container is running.
# Default: 1 (enabled)
FLOORPLAN_BRIDGE_ENABLED=1
