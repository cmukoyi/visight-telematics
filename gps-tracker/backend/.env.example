# Backend Environment Variables
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT: All values containing the substring "your-", "<", "change-me",
# "change-this", or "placeholder" are rejected at container startup by
# app/_env_guard.py to prevent accidentally shipping unfilled placeholders
# to production (this happened with SCOPE_AUTH_HEADER on beacon and caused
# every Series 1 tag validation to return HTTP 401 for months).

# Database — REQUIRED
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DBNAME

# JWT secrets — REQUIRED. Generate with: openssl rand -base64 48
# auth.py reads JWT_SECRET_KEY; admin_auth.py reads ADMIN_SECRET_KEY.
# PORTAL_SECRET_KEY is optional — falls back to ADMIN_SECRET_KEY if unset.
JWT_SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48
ADMIN_SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48
PORTAL_SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48

# SendGrid Email Configuration
SENDGRID_API_KEY=REPLACE_WITH_SENDGRID_KEY
FROM_EMAIL=noreply@example.com

# Azure Translator — REQUIRED to synchronize non-English dashboard translations.
# Create an Azure AI Translator resource, then set its endpoint, key, and region.
AZURE_TRANSLATOR_ENDPOINT=https://YOUR_RESOURCE_NAME.cognitiveservices.azure.com
AZURE_TRANSLATOR_KEY=REPLACE_WITH_AZURE_TRANSLATOR_KEY
AZURE_TRANSLATOR_REGION=YOUR_RESOURCE_REGION

# MZone API — REQUIRED for Series 1 tag fleet polling
MZONE_TOKEN_URL=https://login.mzoneweb.net/connect/token
MZONE_API_BASE=https://live.mzoneweb.net/mzone62.api
MZONE_CLIENT_ID=REPLACE_WITH_MZONE_CLIENT_ID
MZONE_CLIENT_SECRET=REPLACE_WITH_MZONE_CLIENT_SECRET
MZONE_USERNAME=REPLACE_WITH_MZONE_USERNAME
MZONE_PASSWORD=REPLACE_WITH_MZONE_PASSWORD
MZONE_VEHICLE_GROUP_ID=REPLACE_WITH_GUID
# Optional — defaults to MZONE_VEHICLE_GROUP_ID if not set
# MZONE_TRIPS_GROUP_ID=REPLACE_WITH_GUID

# TrackSolid API — REQUIRED for Series 2 tag operations
# (only ACCOUNT/PASSWORD/USER_ID/ORG_ID are used by code — the legacy
# Open-API APP_KEY/APP_SECRET were removed on 2026-05-19 as dead code)
TRACKSOLID_ACCOUNT=REPLACE_WITH_TRACKSOLID_ACCOUNT
TRACKSOLID_PASSWORD=REPLACE_WITH_TRACKSOLID_PASSWORD
TRACKSOLID_USER_ID=REPLACE_WITH_NUMERIC_USER_ID
TRACKSOLID_ORG_ID=REPLACE_WITH_ORG_ID

# Scope (Series 1) API — REQUIRED for tag validation in the add-tag flow
# SCOPE_AUTH_HEADER must be the full "Basic <base64>" header value.
# Container refuses to start if this contains a placeholder substring.
SCOPE_API_BASE_URL=https://live.scopemp.net/Scope.MProfilerIa.WPI/api/v1
SCOPE_AUTH_HEADER=Basic REPLACE_WITH_BASE64_CREDENTIALS

# Hubble Platform API — REQUIRED for Series 5 tag operations
# Get these from Hubble dashboard: https://console.hubble.com
# Developer Tools > API Tokens (requires write-devices and read-devices scopes)
HUBBLE_API_KEY=REPLACE_WITH_HUBBLE_API_TOKEN
HUBBLE_ORG_ID=REPLACE_WITH_HUBBLE_ORG_UUID
# Webhook secret — REQUIRED for real-time packet webhooks
# Get this when you register the webhook endpoint using register_hubble_webhook.py
HUBBLE_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
# Optional — defaults shown below
# HUBBLE_API_BASE=https://api.hubble.com
# HUBBLE_ENCRYPTION=AES-256-CTR
# HUBBLE_COUNTER_SOURCE=UNIX_TIME

# Optional
DEBUG=False
ENVIRONMENT=production

# ── Feature Flags ──────────────────────────────────────────────────────

# Tenant-level feature kill-switch. Comma-separated list (no spaces).
# Features listed here return 404 from portal API regardless of role/group.
# Used for phased rollout or tenant-specific feature gating.
# Options: hive
TENANT_DISABLED_FEATURES=
