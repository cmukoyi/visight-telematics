# ─── Tenant-managed files (assembled by scripts/build.sh) ───────────
customer-dashboard/public/favicon.ico
customer-dashboard/public/favicon-16x16.png
customer-dashboard/public/favicon-32x32.png
customer-dashboard/public/apple-touch-icon.png
customer-dashboard/public/android-chrome-192x192.png
customer-dashboard/public/android-chrome-512x512.png
# Source of truth lives in tenants/<TENANT>/. These paths are written
# at build time by scripts/build.sh on the CI runner. Do not commit
# them by hand — edit the tenant source instead.
admin-portal/assets/logo.png
customer-dashboard/public/assets/logo.png
customer-dashboard/public/custom/activated.html
nginx/nginx.conf
.tenant
# Rendered from docker-compose.template.yml + tenants/<tenant>/tenant.env
docker-compose.yml
